{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules/*.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "snapshot": true,
  "autoupdate": "notify",
  "mcp": {
    "pdf-tools": {
      "type": "local",
      "command": ["uvx", "mcp-pdf"]
    },
    "powerpoint": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "powerpoint-mcp"]
    },
    "scholarsearch-sources": {
      "type": "local",
      "command": ["node", "services/scholarsearch/packages/mcp-sources/dist/mcp-server.js"]
    }
  }
}
