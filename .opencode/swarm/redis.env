# Swarm Redis — CI-only via redis:7-alpine Docker service
# Local MSYS2 Redis 8.10.1 excised 2026-09-10. No local Redis installation.
# CI services bind to 127.0.0.1:6379 with health checks.
# Redis password: see .omniroute/.env or ask user.
REDIS_URL=redis://127.0.0.1:6379/0
# CI uses redis:7-alpine — streams (XADD/XLEN/XREAD) fully supported.
# Local development requires Docker: docker run -d -p 6379:6379 redis:7-alpine
