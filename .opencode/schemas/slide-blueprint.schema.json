{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode.local/schemas/slide-blueprint.json",
  "title": "PDF-to-PowerPoint Intermediate Slide Blueprint",
  "description": "Strict intermediate schema the LLM must emit before any slide is written. The local validator rejects anything that does not conform 100%. Invalid blueprints are never handed to the PowerPoint MCP.",
  "type": "object",
  "required": ["version", "deck", "slides"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Blueprint schema version. Must be exactly '1.0'."
    },
    "source": {
      "type": "object",
      "required": ["file", "page_count"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "page_count": { "type": "integer", "minimum": 1 }
      }
    },
    "deck": {
      "type": "object",
      "required": ["title", "orientation"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/slide" }
    }
  },
  "definitions": {
    "slide": {
      "type": "object",
      "required": ["title", "bullets", "notes", "source_page"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "bullets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "source_page": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
