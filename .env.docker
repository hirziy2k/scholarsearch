# ============================================
# ScholarSearch v1.0.0 — Production Environment
# ============================================
# Copy to .env and fill in values before deployment

# ============================================
# Domain (required for TLS)
# ============================================
DOMAIN=scholarsearch.example.com

# ============================================
# API Source Keys (at least one required)
# ============================================
OPENALEX_EMAIL=your-email@example.com
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_API_KEY=
CORE_API_KEY=
ERIC_API_KEY=
SCOPUS_API_KEY=

# ============================================
# Litestream S3 Backup (required for DR)
# ============================================
LITESTREAM_S3_BUCKET=scholarsearch-backups
LITESTREAM_S3_ENDPOINT=https://s3.amazonaws.com
LITESTREAM_S3_ACCESS_KEY=
LITESTREAM_S3_SECRET_KEY=
LITESTREAM_S3_REGION=us-east-1

# ============================================
# Database (auto-configured by docker-compose)
# ============================================
# DATABASE_URL=file:/data/db/scholarsearch.db

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0
